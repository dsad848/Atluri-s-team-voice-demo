# Optional: Google Gemini API key for live natural language understanding.
# Leave empty to run Voice Access in offline Demonstration Mode.
GEMINI_API_KEY=

# Optional: Demo security PIN used to authorize simulated bookings, payments, and OTP reading.
# Defaults to 1234 if omitted.
DEMO_SECURITY_PIN=1234

# Server port (defaults to 3000)
PORT=3000

# Public URL where this application is hosted
APP_URL=http://localhost:3000
